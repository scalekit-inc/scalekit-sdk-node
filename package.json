{
  "version": "2.20.0",
  "name": "@scalekit-sdk/node",
  "description": "Official Scalekit Node SDK",
  "type": "commonjs",
  "main": "lib/index.cjs",
  "module": "lib/index.mjs",
  "typings": "lib/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./lib/frameworks/express.d.mts",
        "default": "./lib/frameworks/express.mjs"
      },
      "require": {
        "types": "./lib/frameworks/express.d.cts",
        "default": "./lib/frameworks/express.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./lib/frameworks/nextjs.d.mts",
        "default": "./lib/frameworks/nextjs.mjs"
      },
      "require": {
        "types": "./lib/frameworks/nextjs.d.cts",
        "default": "./lib/frameworks/nextjs.cjs"
      }
    },
    "./edge": {
      "import": {
        "types": "./lib/edge.d.mts",
        "default": "./lib/edge.mjs"
      },
      "require": {
        "types": "./lib/edge.d.cts",
        "default": "./lib/edge.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "REFERENCE.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scalekit-inc/scalekit-sdk-node.git"
  },
  "scripts": {
    "generate": "npx buf generate $npm_config_src",
    "prebuild": "prettier --write .",
    "build": "tsdown",
    "check:package": "publint --strict && attw --pack . --profile node16 && node scripts/check-package-load.cjs",
    "lint": "tsc --noEmit",
    "prettier": "prettier --check .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "sso",
    "saml",
    "oidc",
    "sso-authentication",
    "scalekit"
  ],
  "author": "Team Scalekit",
  "license": "ISC",
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "axios": "^1.19.0",
    "qs": "^6.15.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@bufbuild/buf": "^1.70.0",
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jest": "^30.4.2",
    "jose": "^6.2.13",
    "next": "^16.3.0",
    "prettier": "^3.8.4",
    "publint": "^0.3.25",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsdown": "0.21.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "next": "^13.4.0 || ^14.0.0 || ^15.0.0 || ^16.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "bugs": {
    "url": "https://github.com/scalekit-inc/scalekit-sdk-node/issues"
  },
  "homepage": "https://github.com/scalekit-inc/scalekit-sdk-node#readme",
  "directories": {
    "lib": "lib"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "minimatch": "3.1.5"
  }
}
